# ---- Lot Dots env ----
# Copy to .env for local dev. Never commit .env.

# Port the server listens on
PORT=3000

# Long random string used to sign login tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Leave empty for local dev (uses a local SQLite file in ./data).
# Set to a Postgres connection string for production, e.g.:
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

# Where uploaded photos are stored when S3_* is NOT set (created automatically).
# NOTE: local disk is wiped on redeploy on Render — set the S3_* vars below
# in production so photos survive restarts and deploys.
UPLOAD_DIR=./uploads

# ---- Permanent photo storage (S3-compatible: Cloudflare R2, AWS S3, ...) ----
# When all four are set, photos are uploaded to the bucket and served from
# S3_PUBLIC_URL. Recommended: Cloudflare R2 (free 10 GB, no egress fees).
# R2 setup: Cloudflare dashboard → R2 → Create bucket → Manage R2 API tokens →
# create a token with Object Read & Write on that bucket. Then:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_BUCKET=<your-bucket-name>
#   S3_ACCESS_KEY=<token-access-key-id>
#   S3_SECRET_KEY=<token-secret-access-key>
#   S3_PUBLIC_URL=https://pub-<hash>.r2.dev   (bucket → Settings → Public access → R2.dev subdomain,
#                                              or your custom domain; must end with no trailing slash)
#S3_ENDPOINT=
#S3_BUCKET=
#S3_ACCESS_KEY=
#S3_SECRET_KEY=
#S3_PUBLIC_URL=
#S3_REGION=auto

# Where the local SQLite file lives (only used when DATABASE_URL is empty)
SQLITE_PATH=./data/app.db

# ---- Seed admin (used by `npm run seed`) ----
ADMIN_EMAIL=saiber@example.com
ADMIN_PASSWORD=change-me-immediately
ADMIN_NAME=Saiber
