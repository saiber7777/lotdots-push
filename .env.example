# ---- Blossom Rock Crew App env ----
# Copy to .env for local dev. Never commit .env.

# Port the server listens on
PORT=3000

# Long random string used to sign login tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Leave empty for local dev (uses a local SQLite file in ./data).
# Set to a Postgres connection string for production, e.g.:
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

# Where uploaded photos are stored (created automatically)
UPLOAD_DIR=./uploads

# Where the local SQLite file lives (only used when DATABASE_URL is empty)
SQLITE_PATH=./data/app.db

# ---- Seed admin (used by `npm run seed`) ----
ADMIN_EMAIL=saiber@example.com
ADMIN_PASSWORD=change-me-immediately
ADMIN_NAME=Saiber
